---
import Connect from "../components/home/Connect.astro";
import Intro from "../components/home/Intro.astro";
import LatestPosts from "../components/home/LatestPosts.astro";
import ProjectsPreview from "../components/home/ProjectsPreview.astro";
import WorkPreview from "../components/home/WorkPreview.astro";
import Container from "../components/ui/Container.astro";
import { getPosts } from "../data/posts";
import { getProjects } from "../data/projects";
import { profile } from "../data/site";
import { getWorkExperience } from "../data/work";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = await getPosts();
const projects = await getProjects();
const workExperience = await getWorkExperience();

const latestPosts = posts.slice(0, 3);
const recentWork = workExperience.slice(0, 2);
const recentProjects = projects.slice(0, 3);
---

<BaseLayout title="Home" description={profile.defaultDescription}>
  <Container>
    <h1 class="animate font-semibold text-black dark:text-white">
      {profile.greeting}
      <span class="wave ml-1.5 text-base" aria-hidden="true">👋🏻</span>
    </h1>
    <div class="mt-5 space-y-16">
      <Intro />
      <Connect />
      <LatestPosts posts={latestPosts} />
      <WorkPreview experiences={recentWork} />
      <ProjectsPreview projects={recentProjects} />
    </div>
  </Container>
</BaseLayout>
